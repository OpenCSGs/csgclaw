# Copy this file to .desktop-release-oss.env and run chmod 600 on it.
# Never commit the populated file. Process environment values take precedence.

# macOS Developer ID signing and Apple notarization.
# Use a P12 file or leave it empty to use an identity already in Keychain.
CSGCLAW_MACOS_CERTIFICATE_P12_FILE=""
CSGCLAW_MACOS_CERTIFICATE_PASSWORD=""
APPLE_ID=""
APPLE_PASSWORD=""
APPLE_TEAM_ID=""

# CI may set Base64 P12 content instead of a local P12 file.
# CSGCLAW_MACOS_CERTIFICATE_P12_BASE64=""

# OSS publishing credentials and settings.
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""

OSS_REGION="cn-beijing"
OSS_ENDPOINT="https://oss-cn-beijing.aliyuncs.com"
OSS_BUCKET="opencsg-public-resource"
OSS_PREFIX="csgclaw-desktop"
OSS_PUBLIC_BASE_URL="https://opencsg-public-resource.oss-cn-beijing.aliyuncs.com/csgclaw-desktop"
