{
  "name": "csgclaw-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "CSGClaw React UI primitives, styles, and theme tokens.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/OpenCSGs/csgclaw",
  "keywords": [
    "csgclaw",
    "react",
    "ui",
    "radix"
  ],
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "csgclaw-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./src/styles.css.d.ts",
      "csgclaw-source": "./src/theme.css",
      "default": "./dist/styles.css"
    },
    "./testing/*": {
      "csgclaw-source": "./src/components/*"
    }
  },
  "scripts": {
    "build": "vite build && tsc",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "lucide-react": "~1.16.0",
    "radix-ui": "~1.6.1"
  },
  "devDependencies": {
    "react": "~19.2.6",
    "react-dom": "~19.2.6",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@types/node": "~24.12.4",
    "@vitejs/plugin-react": "~6.0.2",
    "typescript": "~6.0.3",
    "vite": "~8.0.13"
  },
  "packageManager": "pnpm@11.1.3",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenCSGs/csgclaw.git",
    "directory": "web/packages/csgclaw-ui"
  }
}
